# MCP Stack Environment Variables
# Copy this file to .env and fill in your actual tokens.
# NEVER commit .env to version control.
# Recommended: chmod 600 .env

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token or OAuth token
# Minimal scope: repo:read, read:user
GITHUB_TOKEN=your_github_token_here

# ─── Notion ───────────────────────────────────────────────────────────────────
# Integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_token_here

# ─── StackOne ─────────────────────────────────────────────────────────────────
STACKONE_API_KEY=your_stackone_api_key_here

# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Scoped API token (not Global API Key)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ─── Firecrawl ────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-your_firecrawl_key_here

# ─── Make (Integromat) ────────────────────────────────────────────────────────
MAKE_API_KEY=your_make_api_key_here
MAKE_TEAM_ID=your_make_team_id_here

# ─── Google Drive ─────────────────────────────────────────────────────────────
# OAuth2 access token (refresh via google-auth-library)
GOOGLE_DRIVE_TOKEN=your_google_oauth_token_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Microsoft OneDrive ───────────────────────────────────────────────────────
# OAuth2 access token via Azure App Registration
ONEDRIVE_TOKEN=your_onedrive_oauth_token_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_TENANT_ID=your_azure_tenant_id_here

# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Use anon key for read-only; service role key for write access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Auth token from Sentry Settings > Developer Settings > Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_your_sentry_token_here
SENTRY_ORG_SLUG=your_org_slug_here
